# Copy to .env and fill in. .env is git-ignored; never commit secrets.
# Generate the three secrets below with:  uv run analyst gen-secrets

# --- App database (ours: checkpoints, source registry, embeddings, audit log) ---
APP_DB_USER=agent_app
APP_DB_PASSWORD=change-me-app
APP_DB_NAME=agent_app
APP_DB_HOST=localhost
APP_DB_PORT=5433

# --- Secrets ---
# Fernet key: encrypts data-source credentials (MCP server only)
APP_SECRET_KEY=
# HMAC key: signs human approvals (API signs, MCP verifies)
APPROVAL_SIGNING_KEY=
# bearer token the API uses to call the MCP server
MCP_AUTH_TOKEN=

# --- MCP ---
# Leave empty to run tools in-process (simplest for local dev).
# Set to http://localhost:8001/mcp after starting:  uv run python -m analyst.mcp_server
MCP_URL=

# --- Chat LLM: any OpenAI-compatible endpoint (OpenAI, vLLM, SGLang, Ollama, LiteLLM...) ---
# Leave OPENAI_BASE_URL empty for api.openai.com.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# a chat model that supports structured outputs (JSON schema or tool calling)
OPENAI_MODEL=
# json_schema | function_calling | json_mode (use function_calling if your server lacks guided decoding)
LLM_STRUCTURED_METHOD=json_schema
# true for Qwen3-style reasoning models served by vLLM/SGLang: disables <think> output
LLM_DISABLE_THINKING=false

# --- Embeddings: any OpenAI-compatible /v1/embeddings endpoint ---
# Self-hosted BGE-M3 (1024 dims). For OpenAI instead: empty base URL, text-embedding-3-small, 1536
# (and a migration changing vector(1024) -> vector(1536)).
EMBEDDING_BASE_URL=http://127.0.0.1:8008/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=64

# --- Optional: tracing with LangSmith (every LLM call, tool call and graph step) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=data-analyst-agent

# --- File-based sources (CSV/Parquet/DuckDB) are only read from this directory ---
LOCAL_DATA_DIR=data

# --- Demo data source (example "plugged-in" database for tests/evals/demos) ---
DEMO_DB_ADMIN_PASSWORD=change-me-demo-admin
DEMO_DB_RO_PASSWORD=change-me-demo-ro
DEMO_DB_HOST=localhost
DEMO_DB_PORT=5434
